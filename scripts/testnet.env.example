# Copy to a local file outside the repo, fill in real values, then:
#   scripts/create-testnet-env.sh --env-file <path>
# Real hosts/addresses live only in the GitHub environment, never in the repo.

# Comma-separated droplet public addresses the CD runner SSHes into
DO_HOST_LIST=<droplet-public-ip>
ELECTRS_USER=opcat
# Electrum/HTTP bind to the droplet's VPC address only; daemon RPC over VPC
ELECTRS_ARGS="--network=opcattestnet --daemon-rpc-addr=<node-vpc-ip>:28443 --electrum-rpc-addr=<droplet-vpc-ip>:50006 --http-addr=<droplet-vpc-ip>:3006 --db-dir=/var/lib/electrs/db --utxos-limit=500000 --electrum-txs-limit=100000 --address-search -vv --timestamp"
LAYER_RPC_USER=<rpc-user>

# Secrets (stored as environment secrets, never as variables)
LAYER_RPC_PASSWORD=
# Private half of the per-droplet CD key; public half goes in /home/opcat/.ssh/authorized_keys
DO_SSH_KEY_FILE=<path-to-cd-private-key>
